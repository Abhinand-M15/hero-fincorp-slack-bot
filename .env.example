# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---------------------------------------------------------------------------
# Salesforce (JWT Bearer Flow — needs server.key alongside app.py)
# ---------------------------------------------------------------------------
SF_LOGIN_DOMAIN=
SF_CONSUMER_KEY=
SF_USERNAME=

# simulate = build and show the exact REST call without sending it (default,
#            used while the custom objects are not yet deployed in the org)
# live     = actually send it
SF_WRITE_MODE=simulate
SF_API_VERSION=v61.0

# Object API names, if the org calls them something else.
HFC_SF_VISIT_OBJECT=Collections_Visit__c
HFC_SF_PTP_OBJECT=Promise_To_Pay__c
HFC_SF_CASE_OBJECT=Case
HFC_SF_APPROVAL_OBJECT=Credit_Approval_Request__c
HFC_SF_TASK_OBJECT=Task

# ---------------------------------------------------------------------------
# Who is who — Slack user IDs
# ---------------------------------------------------------------------------
# REQUIRED for anyone to see anything. The bot creates the journey channels
# privately, so a private channel is invisible to everyone who is not a member
# — workspace admins included. Put your own Slack member ID here and you are
# invited to all of them. Find it: Slack -> your profile -> ⋮ -> Copy member ID.
# Comma-separate to add colleagues who should watch along.
#
# Presenters are deliberately NOT mapped to a persona: in relaxed access mode
# their identity follows whichever channel they are acting in, so one account
# can walk through the agent, manager, approver and security views in turn.
HFC_PRESENTER_SLACK_IDS=

# The two sample partner agents. Leave BOTH blank for a one-person walkthrough.
# Set HFC_AGENT_B_SLACK_ID to a real second account (a guest works well) when
# you want to show, from two sidebars, that one agent cannot see the other's
# customers. That account is then invited to its own channel and nothing else.
HFC_AGENT_A_SLACK_ID=
HFC_AGENT_B_SLACK_ID=

# Internal Hero FinCorp staff. Optional — leave blank for a one-person
# walkthrough; the cards fall back to names instead of @mentions.
HFC_MANAGER_SLACK_ID=
HFC_LEGAL_SLACK_ID=
HFC_APPROVER_L1_SLACK_ID=
HFC_APPROVER_L2_SLACK_ID=
HFC_APPROVER_L3_SLACK_ID=
HFC_ADMIN_SLACK_ID=

# strict  = the Slack user must map to one of the IDs above
# relaxed = (default) an unrecognised user is identified by the private channel
#           they are acting in, so a single-account workspace can still run the
#           whole journey. Record-level ownership is enforced either way.
HFC_ACCESS_MODE=relaxed

# ---------------------------------------------------------------------------
# Nudges and reminders
# ---------------------------------------------------------------------------
HFC_NUDGE_START=11:00
HFC_NUDGE_MIDDAY=15:00
HFC_NUDGE_END=18:00
HFC_REMINDER_HOUR=9

# true = promise-to-pay and revisit reminders land ~90 seconds later instead of
#        on the real date, so they can be seen during a live demo.
HFC_DEMO_FAST=false

# ---------------------------------------------------------------------------
# CPA
# ---------------------------------------------------------------------------
# The discovery call said "CPA" without expanding it. Set the expansion once
# HFCL confirms it, then set CONFIRMED=true to drop the caveat from the UI.
HFC_CPA_EXPANSION=Credit Policy Approval
HFC_CPA_EXPANSION_CONFIRMED=false
